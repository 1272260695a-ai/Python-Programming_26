#     ***** STRING SEARCHING USING REGEX (FULLMATCH) FUNCTION *****
import re
def is_alphanumeric(s):
    return bool(re.fullmatch(r'[A-Za-z0-9 ]+',s))
txt = input("Enter String:")
if is_alphanumeric(txt):
    print("Valid")
else:
    print("Invalid")
